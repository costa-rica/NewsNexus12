RUN_ENVIRONMENT=development
NAME_APP=worker-python
PATH_TO_LOGS=/absolute/path/to/logs
PATH_UTILTIES=/absolute/path/to/utilities
# AI Approver V02 always uses the Codex CLI.
AI_APPROVER_V02_MODEL_NAME=gpt-5.4-mini
AI_APPROVER_V02_CODEX_TIMEOUT_SECONDS=180
AI_APPROVER_V02_EXPIRED_PREVIEW_RETENTION_DAYS=7
# Optional; accepted previews expire after this many minutes.
AI_APPROVER_V02_PREVIEW_TTL_MINUTES=15
NAME_AI_ENTITY_LOCATION_SCORER=NewsNexusClassifierLocationScorer01
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=newsnexus_dev
PG_USER=postgres
PG_PASSWORD=
PG_SCHEMA=public
