RUN_ENVIRONMENT=development
NAME_APP=worker-python
PATH_TO_LOGS=/absolute/path/to/logs
PATH_UTILTIES=/absolute/path/to/utilities
# AI approver backend selection: the Codex CLI is the default backend.
# Set USE_OPEN_AI_API=true (with OPENAI_API_KEY) to use the OpenAI API instead.
USE_OPEN_AI_API=false
# Optional; only used by the OpenAI API backend (USE_OPEN_AI_API=true).
OPENAI_API_KEY=replace-me
# Model for both backends: OpenAI API model param and codex exec -m flag.
# For the Codex CLI backend use a Codex-supported model (e.g. gpt-5.4-mini);
# gpt-4o-mini is rejected by Codex with a ChatGPT login.
AI_APPROVER_MODEL_NAME=gpt-4o-mini
# Per-article codex exec subprocess timeout in seconds.
AI_APPROVER_CODEX_TIMEOUT_SECONDS=180
NAME_AI_ENTITY_LOCATION_SCORER=NewsNexusClassifierLocationScorer01
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=newsnexus_dev
PG_USER=postgres
PG_PASSWORD=
PG_SCHEMA=public
