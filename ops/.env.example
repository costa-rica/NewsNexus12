NODE_ENV=development
NAME_APP=newsnexus12-weekly-pipeline
URL_BASE_NEWS_NEXUS_PYTHON_QUEUER=http://127.0.0.1:5000/
WORKER_PYTHON_REQUEST_TIMEOUT_SECONDS=90
URL_BASE_NEWS_NEXUS_WORKER_NODE=http://127.0.0.1:3002/
# Phase 4 worker-node request and monitoring policy.
WORKER_NODE_REQUEST_TIMEOUT_SECONDS=60
RSS_STATUS_POLL_INTERVAL_SECONDS=300
RSS_TOLERATED_CONSECUTIVE_STATUS_FAILURES=2
RSS_JOB_TIMEOUT_HOURS=24
# Phase 5 semantic-scorer monitoring policy.
SEMANTIC_SCORER_STATUS_POLL_INTERVAL_SECONDS=300
SEMANTIC_SCORER_TOLERATED_CONSECUTIVE_STATUS_FAILURES=2
SEMANTIC_SCORER_MONITORING_LIMIT_HOURS=6
# Phase 6 state-assigner targeting and monitoring policy.
STATE_ASSIGNER_TARGET_ARTICLE_THRESHOLD_DAYS_OLD=180
STATE_ASSIGNER_STATUS_POLL_INTERVAL_SECONDS=300
STATE_ASSIGNER_TOLERATED_CONSECUTIVE_STATUS_FAILURES=2
STATE_ASSIGNER_MONITORING_LIMIT_HOURS=12

AI_APPROVER_V02_REQUEST_TIMEOUT_SECONDS=60
AI_APPROVER_V02_STATUS_POLL_INTERVAL_SECONDS=300
AI_APPROVER_V02_TOLERATED_CONSECUTIVE_STATUS_FAILURES=2
AI_APPROVER_V02_MONITORING_LIMIT_HOURS=12
# Overall limit for the db-manager backup child process, in seconds.
DB_MANAGER_BACKUP_TIMEOUT_SECONDS=1800
# Overall limit for the db-manager old-article deletion child process, in seconds.
DB_MANAGER_DELETE_ARTICLES_TIMEOUT_SECONDS=1800
# Ops persistence uses the application role. Keep bootstrap-owner credentials in db-manager only.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=newsnexus_prod
PG_USER=newsnexus_app
PG_PASSWORD=replace_with_application_role_password
PG_SCHEMA=public
# Relative paths are resolved from ops/, regardless of the invoking directory.
PATH_TO_LOGS=./logs
# File rotation size in MB and retained file count.
LOG_MAX_SIZE=5
LOG_MAX_FILES=5
