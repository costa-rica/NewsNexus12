NODE_ENV=development
NAME_APP=newsnexus12-weekly-pipeline
URL_BASE_NEWS_NEXUS_PYTHON_QUEUER=http://127.0.0.1:5000/
WORKER_PYTHON_REQUEST_TIMEOUT_SECONDS=30
# Relative paths are resolved from ops/, regardless of the invoking directory.
PATH_TO_LOGS=./logs
# File rotation size in MB and retained file count.
LOG_MAX_SIZE=5
LOG_MAX_FILES=5
