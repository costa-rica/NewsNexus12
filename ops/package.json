{
  "name": "newsnexus12-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Operational processes for NewsNexus12",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean:test": "node -e \"require('node:fs').rmSync('dist-test', { recursive: true, force: true })\"",
    "test:build": "npm run clean:test && tsc -p tsconfig.test.json",
    "test": "npm run test:build && node --test dist-test/tests/config.test.js dist-test/tests/weekly-flow-02/01_clearDuplicateAnalyses.test.js dist-test/tests/weekly-flow-02/02_createDatabaseBackup.test.js dist-test/tests/weekly-flow-02/03_deleteOldArticles.test.js dist-test/tests/weekly-flow-02/04_googleNewsRssClient.test.js dist-test/tests/weekly-flow-02/04_collectGoogleNewsRss.test.js dist-test/tests/weekly-flow-02/05_semanticScorerClient.test.js dist-test/tests/weekly-flow-02/05_runSemanticScoring.test.js dist-test/tests/weekly-flow-02/06_stateAssignerClient.test.js dist-test/tests/weekly-flow-02/06_runStateAssignment.test.js dist-test/tests/weekly-flow-02/entrypoint.test.js dist-test/tests/weekly-flow-02/launcher.test.js dist-test/tests/weekly-flow-02/persistence.test.js dist-test/tests/weekly-flow-02/runSelection.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "weekly-flow-02:dev": "tsx src/weekly-flow-02/index.ts",
    "weekly-flow-02:start": "sh scripts/runWeeklyFlow02.sh"
  },
  "dependencies": {
    "@newsnexus/db-models": "file:../db-models",
    "dotenv": "^17.2.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.22.4",
    "typescript": "^5.8.2"
  }
}
